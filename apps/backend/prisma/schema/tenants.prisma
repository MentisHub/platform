model Organization {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(255)
  ownerId              String                @map("owner_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  nodes                Node[]
  fabs                 Fab[]
  members              OrganizationMember[]
  owner                User                  @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  projectCollaborators ProjectCollaborator[]
  projects             Project[]

  @@index([ownerId])
  @@map("organizations")
  @@schema("platform")
}

model OrganizationMember {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now()) @map("joined_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@map("organization_members")
  @@schema("platform")
}

model Project {
  id              String                @id @default(uuid()) @db.Uuid
  name            String                @db.VarChar(255)
  organizationId  String                @map("organization_id") @db.Uuid
  trainingConfig  Json?                 @map("training_config")
  federationName  String                @map("federation_name") @db.VarChar(255)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  nodes           Node[]
  collaborators   ProjectCollaborator[]
  fabs            Fab[]
  projectMembers  ProjectMember[]
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trainingRuns    TrainingRun[]

  @@map("projects")
  @@schema("platform")
}

model ProjectCollaborator {
  projectId      String       @map("project_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  invitedBy      String?      @map("invited_by") @db.Uuid
  invitedAt      DateTime     @default(now()) @map("invited_at")
  acceptedAt     DateTime?    @map("accepted_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, organizationId])
  @@map("project_collaborators")
  @@schema("platform")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  invitedBy String?     @map("invited_by") @db.Uuid
  invitedAt DateTime    @default(now()) @map("invited_at")
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
  @@schema("platform")
}

enum OrgRole {
  ADMIN
  MEMBER

  @@schema("platform")
}

enum ProjectRole {
  ADMIN
  MEMBER

  @@schema("platform")
}
