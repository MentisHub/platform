model Fab {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  publisherName String   @map("publisher_name") @db.VarChar(100)
  description   String?  @db.Text
  fabHash       String   @unique @map("fab_hash") @db.VarChar(64)
  version       String   @db.VarChar(20)
  storagePath   String   @map("storage_path") @db.VarChar(500)
  sizeBytes     BigInt   @map("size_bytes")
  isDefault     Boolean  @default(false) @map("is_default")
  isPublic      Boolean  @default(false) @map("is_public")
  tags          String[] @default([])

  organizationId String? @map("organization_id") @db.Uuid
  projectId      String? @map("project_id") @db.Uuid
  uploadedBy     String  @map("uploaded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trainingRuns TrainingRun[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([fabHash])
  @@index([tags(ops: ArrayOps)], type: Gin)
  @@map("fabs")
  @@schema("platform")
}
