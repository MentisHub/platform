model Node {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @db.VarChar(255)
  status         NodeStatus @default(CREATED)
  flowerNodeId   String?    @unique @map("flower_node_id")
  metadata       Json?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  ecPublicKey    String?    @map("ec_public_key")
  organizationId String     @map("organization_id") @db.Uuid
  projectId      String?    @map("project_id") @db.Uuid
  createdById    String     @map("created_by_id") @db.Uuid

  pskHash      String?   @map("token_hash")
  activatedAt  DateTime? @map("activated_at")
  lastActiveAt DateTime? @map("last_seen_at")

  createdBy           User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  roundParticipations RoundParticipant[]
  runParticipations   RunParticipant[]
  trainingRuns        TrainingRun[]
  refreshTokens       NodeRefreshToken[]

  @@index([organizationId])
  @@map("nodes")
  @@schema("platform")
}

model NodeRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  nodeId    String    @map("node_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([token])
  @@map("node_refresh_tokens")
  @@schema("platform")
}

model TrainingRun {
  id            String           @id @default(uuid()) @db.Uuid
  status        TrainingStatus   @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  projectId     String           @map("project_id") @db.Uuid
  fabId         String?          @map("fab_id") @db.Uuid
  flowerRunId   String?          @map("flower_run_id")
  configuration Json?
  createdById   String           @map("created_by_id") @db.Uuid
  metrics       Json?            // Stores final metrics like loss, accuracy, etc.
  artifacts     Artifact[]
  rounds        Round[]
  participants  RunParticipant[]
  serverAppId   String?          @map("serverapp_id") @db.Uuid
  serverAppNode Node?            @relation(fields: [serverAppId], references: [id], onDelete: SetNull)
  fab           Fab?             @relation(fields: [fabId], references: [id], onDelete: SetNull)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([fabId])
  @@map("training_runs")
  @@schema("platform")
}

model Round {
  id                     String             @id @default(uuid()) @db.Uuid
  number                 Int
  startedAt              DateTime           @default(now()) @map("started_at")
  completedAt            DateTime?          @map("completed_at")
  totalParticipants      Int?               @map("total_participants")
  successfulParticipants Int?               @map("successful_participants")
  metrics                Json?              // Stores aggregated metrics like loss, accuracy, etc.
  runId                  String             @map("run_id") @db.Uuid
  participants           RoundParticipant[]
  run                    TrainingRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, number])
  @@map("rounds")
  @@schema("platform")
}

model RunParticipant {
  joinedAt DateTime    @default(now()) @map("joined_at")
  endedAt  DateTime?   @map("ended_at")
  runId    String      @map("run_id") @db.Uuid
  nodeId   String      @map("node_id") @db.Uuid
  node     Node        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  run      TrainingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, nodeId])
  @@map("run_participants")
  @@schema("platform")
}

model RoundParticipant {
  failureReason String?   @map("failure_reason") @db.VarChar(500)
  startedAt     DateTime? @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  metrics       Json?     // Stores per-node metrics (fit: train_loss, train_accuracy; evaluate: loss, accuracy, num_examples, etc.)
  roundId       String    @map("round_id") @db.Uuid
  nodeId        String    @map("node_id") @db.Uuid
  node          Node      @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  round         Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@id([roundId, nodeId])
  @@map("round_participants")
  @@schema("platform")
}

model Artifact {
  id          String      @id @default(uuid()) @db.Uuid
  bucketKey   String      @map("bucket_key")
  sizeBytes   BigInt      @map("size_bytes")
  roundNumber Int         @map("round_number")
  createdAt   DateTime    @default(now()) @map("created_at")
  runId       String      @map("run_id") @db.Uuid
  run         TrainingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("artifacts")
  @@schema("platform")
}

enum TrainingStatus {
  PENDING // Training created, waiting for ServerApp deployment
  DEPLOYING // ServerApp container is being deployed
  READY // ServerApp deployed successfully, waiting to start execution
  RUNNING // Training is actively running
  PAUSED // Training execution paused (reserved for future use)
  COMPLETED // Training finished successfully
  FAILED // Training failed during execution
  CANCELLED // Training was manually cancelled

  @@schema("platform")
}

enum NodeStatus {
  CREATED // Node just created, waiting for bootstrap (certificate issuance)
  INITIALIZING // Node activated, downloading FAB and installing dependencies
  READY // Node has valid certificate and is ready to participate in training
  ACTIVE // Node is currently participating in an active training run
  ERROR // Node encountered an error (e.g., certificate issues, connection problems)
  OFFLINE // Node is disconnected or unreachable

  @@schema("platform")
}
