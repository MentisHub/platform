model Node {
  id             String     @id
  name           String     @db.VarChar(255)
  status         NodeStatus @default(INACTIVE)
  metadata       Json?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  organizationId String     @map("organization_id") @db.Uuid
  projectId      String?    @map("project_id") @db.Uuid
  createdById    String     @map("created_by_id") @db.Uuid

  createdBy           User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  certificate         NodeCertificate?
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  roundParticipations RoundParticipant[]
  runParticipations   RunParticipant[]

  @@index([organizationId])
  @@map("nodes")
  @@schema("platform")
}

model TrainingRun {
  id           String           @id @default(uuid()) @db.Uuid
  status       TrainingStatus   @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")
  projectId    String           @map("project_id") @db.Uuid
  artifacts    Artifact[]
  rounds       Round[]
  participants RunParticipant[]
  serverApp    ServerApp?
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("training_runs")
  @@schema("platform")
}

model Round {
  id           String             @id @default(uuid()) @db.Uuid
  number       Int
  startedAt    DateTime           @default(now()) @map("started_at")
  completedAt  DateTime?          @map("completed_at")
  runId        String             @map("run_id") @db.Uuid
  participants RoundParticipant[]
  run          TrainingRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, number])
  @@map("rounds")
  @@schema("platform")
}

model RunParticipant {
  joinedAt DateTime    @default(now()) @map("joined_at")
  runId    String      @map("run_id") @db.Uuid
  nodeId   String      @map("node_id")
  node     Node        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  run      TrainingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, nodeId])
  @@map("run_participants")
  @@schema("platform")
}

model RoundParticipant {
  participated  Boolean @default(true)
  failureReason String? @map("failure_reason") @db.VarChar(500)
  roundId       String  @map("round_id") @db.Uuid
  nodeId        String  @map("node_id")
  node          Node    @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  round         Round   @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@id([roundId, nodeId])
  @@map("round_participants")
  @@schema("platform")
}

model Artifact {
  id          String      @id @default(uuid()) @db.Uuid
  bucketKey   String      @map("bucket_key")
  sizeBytes   BigInt      @map("size_bytes")
  roundNumber Int         @map("round_number")
  createdAt   DateTime    @default(now()) @map("created_at")
  runId       String      @map("run_id") @db.Uuid
  run         TrainingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("artifacts")
  @@schema("platform")
}

model ServerApp {
  id            String                @id @default(uuid()) @db.Uuid
  status        ServerAppStatus       @default(STARTING)
  trainingRunId String                @unique @map("training_run_id") @db.Uuid
  podName       String?               @map("pod_name")
  nodeHost      String?               @map("node_host")
  startedAt     DateTime              @default(now()) @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  certificate   ServerAppCertificate?
  trainingRun   TrainingRun           @relation(fields: [trainingRunId], references: [id], onDelete: Cascade)

  @@map("server_apps")
  @@schema("platform")
}

enum TrainingStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED

  @@schema("platform")
}

enum NodeStatus {
  RUNNING
  ONLINE
  OFFLINE
  INACTIVE

  @@schema("platform")
}

enum ServerAppStatus {
  STARTING
  RUNNING
  AGGREGATING
  COMPLETED
  FAILED

  @@schema("platform")
}
